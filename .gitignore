__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# Run artefacts: journals, reports and checkpoints are per-run outputs.
# The experiment REGISTRY is deliberately NOT ignored - see docs/adr/0002.
runs/*.jsonl
runs/*.checkpoint.json
runs/report_*.txt
!runs/experiments.jsonl

# Market data is licensed; never commit vendor data.
data/*.csv
!data/SYNTHETIC_*.csv

# V0.2 (ADR 0003): raw provider artifacts and the canonical cache built from
# them are local-only. Provenance manifests live alongside them but are
# equally excluded - regenerate them from the pipeline, never commit them.
data/raw/
data/cache/
